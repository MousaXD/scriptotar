{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptotar Next",
  "version": "0.1.0",
  "identifier": "io.github.mousaxd.scriptotar.next",
  "build": {
    "beforeBuildCommand": "npm ci && npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scriptotar Next",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
