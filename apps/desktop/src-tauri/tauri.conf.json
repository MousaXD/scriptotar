{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptotar Next",
  "version": "0.1.0",
  "identifier": "io.github.mousaxd.scriptotar.next",
  "build": {
    "beforeBuildCommand": "cd ../desktop-ui && npm ci && npm run build",
    "beforeDevCommand": "cd ../desktop-ui && npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": ["main-capability"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Scriptotar Next",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
